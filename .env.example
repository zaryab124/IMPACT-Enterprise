# ==============================================================================
# IMPACT Enterprise AI Sales & Communication Agent — Environment Configuration
# ==============================================================================
# COPY THIS FILE TO .env.local FOR LOCAL DEVELOPMENT.
# NEVER COMMIT .env OR .env.local TO VERSION CONTROL.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Security & Session Secrets (Generate strong random 64-char keys in production)
JWT_SECRET=development_jwt_secret_change_me_in_production_min32chars
SESSION_SECRET=development_session_secret_change_me_in_production_min32chars

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/impact_agent?schema=public

# Cache & Real-Time Queue (Redis)
REDIS_URL=redis://localhost:6379

# Google Gemini API (Server-side ONLY. NEVER expose to client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# WhatsApp Business Cloud API Configuration
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verification_secret_token

# Email (SMTP) Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=impactenterprise527@gmail.com
SMTP_PASSWORD=your_smtp_app_password
EMAIL_FROM=impactenterprise527@gmail.com

# Telephony / SIP Configuration (Phase 12)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
