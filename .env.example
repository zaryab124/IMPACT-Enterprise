# ==============================================================================
# IMPACT Enterprise: Environment Configuration Template
# ==============================================================================

# Server & Runtime
NODE_ENV="development"
PORT=3005

# Database Configuration (PostgreSQL)
# For remote/containerized PostgreSQL:
DATABASE_URL="postgresql://impact_user:impact_secure_password_2026@localhost:5432/impact_enterprise"
# If DATABASE_URL is not set or unreachable, the system automatically uses embedded PostgreSQL (PGlite) in development.

# Redis Configuration (Pub/Sub & Caching)
REDIS_URL="redis://localhost:6379"

# Google Gemini API (Server-Side Only - NEVER expose to client)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Authentication & Sessions
SESSION_SECRET="replace-with-a-cryptographically-secure-random-64-character-string"
JWT_SECRET="replace-with-a-cryptographically-secure-random-64-character-string"

# Multi-Channel Integrations (Phase 10+)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
RESEND_API_KEY=""

# Telephony (Phase 12+)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
